# =========================================================
# Application
# =========================================================
PROJECT_NAME=retail-intelligence-platform
ENVIRONMENT=local

CUSTOMER_WEB_PORT=3000
ADMIN_WEB_PORT=3001
API_GATEWAY_PORT=8080

# =========================================================
# PostgreSQL
# =========================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DATABASE=retail
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=replace_me

# =========================================================
# MongoDB
# =========================================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=retail_catalog
MONGODB_USER=retail_user
MONGODB_PASSWORD=replace_me

# =========================================================
# Redis
# =========================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_me

# =========================================================
# Kafka
# =========================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# =========================================================
# Kafka Connect and Debezium
# =========================================================
KAFKA_CONNECT_URL=http://localhost:8083
DEBEZIUM_CONNECTOR_NAME=retail-postgres-connector

# =========================================================
# MinIO / local object storage
# =========================================================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=retail-lakehouse
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me

# =========================================================
# Spark
# =========================================================
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=8g
SPARK_SHUFFLE_PARTITIONS=32

# =========================================================
# MLflow
# =========================================================
MLFLOW_TRACKING_URI=http://localhost:5000

# =========================================================
# AWS
# =========================================================
AWS_REGION=ap-south-1

# =========================================================
# Observability
# =========================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# Source-data generator
RETAIL_GENERATOR_HOST=127.0.0.1
RETAIL_GENERATOR_PORT=5439
RETAIL_GENERATOR_DATABASE=retail_platform
RETAIL_GENERATOR_USER=retail_app
RETAIL_GENERATOR_PASSWORD_FILE=secrets/postgres/app_password.txt
RETAIL_GENERATOR_SEED=20260829
RETAIL_GENERATOR_BATCH_SIZE=5000
RETAIL_GENERATOR_PROFILE=small
RETAIL_GENERATOR_CONNECT_TIMEOUT_SECONDS=10