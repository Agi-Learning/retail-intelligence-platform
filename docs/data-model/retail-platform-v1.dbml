Project retail_intelligence_platform {
  database_type: "PostgreSQL"
  Note: "Logical model for the Retail Intelligence e-commerce platform."
}

/*
=========================================================
ENUMERATIONS
=========================================================
*/

Enum customer_status {
  PENDING
  ACTIVE
  LOCKED
  SUSPENDED
  CLOSED
}

Enum address_type {
  HOME
  WORK
  BILLING
  SHIPPING
  OTHER
}

Enum product_status {
  DRAFT
  ACTIVE
  INACTIVE
  DISCONTINUED
}

Enum cart_status {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

Enum order_status {
  PENDING
  INVENTORY_RESERVED
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

Enum reservation_status {
  PENDING
  RESERVED
  RELEASED
  CONSUMED
  REJECTED
  EXPIRED
}

Enum payment_status {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

Enum event_status {
  PENDING
  PUBLISHED
  FAILED
  DEAD
}

/*
=========================================================
IDENTITY SCHEMA
=========================================================
*/

Table identity.customers {
  customer_id bigint [pk, increment]
  public_id uuid [not null, unique]
  first_name varchar(100) [not null]
  last_name varchar(100)
  email varchar(320) [not null, unique]
  phone_number varchar(32)
  status customer_status [not null, default: 'PENDING']
  registered_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 0]

  Indexes {
    email [unique, name: 'uq_customers_email']
    public_id [unique, name: 'uq_customers_public_id']
    (status, registered_at) [name: 'idx_customers_status_registered']
  }

  Note: "Customer business profile. Authentication secrets will be stored separately."
}

Table identity.credentials {
  credential_id bigint [pk, increment]
  customer_id bigint [not null, unique]
  password_hash varchar(255) [not null]
  password_changed_at timestamptz [not null, default: `now()`]
  failed_attempts smallint [not null, default: 0]
  locked_until timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    customer_id [unique, name: 'uq_credentials_customer']
  }

  Note: "Contains only password hashes, never plain-text passwords."
}

Table identity.addresses {
  address_id bigint [pk, increment]
  public_id uuid [not null, unique]
  customer_id bigint [not null]
  address_type address_type [not null, default: 'HOME']
  recipient_name varchar(200) [not null]
  phone_number varchar(32)
  address_line_1 varchar(255) [not null]
  address_line_2 varchar(255)
  city varchar(100) [not null]
  state_region varchar(100) [not null]
  postal_code varchar(20) [not null]
  country_code char(2) [not null]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    customer_id [name: 'idx_addresses_customer']
    (customer_id, is_default) [name: 'idx_addresses_customer_default']
  }
}

Ref: identity.credentials.customer_id - identity.customers.customer_id
Ref: identity.addresses.customer_id > identity.customers.customer_id

/*
=========================================================
CATALOG SCHEMA
=========================================================
*/

Table catalog.brands {
  brand_id bigint [pk, increment]
  public_id uuid [not null, unique]
  brand_name varchar(150) [not null, unique]
  description text
  website_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table catalog.categories {
  category_id bigint [pk, increment]
  public_id uuid [not null, unique]
  parent_category_id bigint
  category_name varchar(150) [not null]
  category_slug varchar(180) [not null, unique]
  description text
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    parent_category_id [name: 'idx_categories_parent']
    category_slug [unique, name: 'uq_categories_slug']
  }
}

Table catalog.products {
  product_id bigint [pk, increment]
  public_id uuid [not null, unique]
  sku varchar(64) [not null, unique]
  category_id bigint [not null]
  brand_id bigint
  product_name varchar(255) [not null]
  product_slug varchar(280) [not null, unique]
  short_description varchar(1000)
  full_description text
  status product_status [not null, default: 'DRAFT']
  attributes jsonb
  weight_grams integer
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 0]

  Indexes {
    sku [unique, name: 'uq_products_sku']
    product_slug [unique, name: 'uq_products_slug']
    category_id [name: 'idx_products_category']
    brand_id [name: 'idx_products_brand']
    (status, category_id) [name: 'idx_products_status_category']
  }
}

Table catalog.product_prices {
  product_price_id bigint [pk, increment]
  product_id bigint [not null]
  currency_code char(3) [not null]
  list_price numeric(19,4) [not null]
  sale_price numeric(19,4)
  valid_from timestamptz [not null]
  valid_to timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (product_id, currency_code, valid_from) [
      name: 'idx_product_prices_effective'
    ]
  }

  Note: "Maintains historical price periods instead of overwriting past prices."
}

Ref: catalog.categories.parent_category_id > catalog.categories.category_id
Ref: catalog.products.category_id > catalog.categories.category_id
Ref: catalog.products.brand_id > catalog.brands.brand_id
Ref: catalog.product_prices.product_id > catalog.products.product_id

/*
=========================================================
INVENTORY SCHEMA
=========================================================
*/

Table inventory.warehouses {
  warehouse_id bigint [pk, increment]
  public_id uuid [not null, unique]
  warehouse_code varchar(32) [not null, unique]
  warehouse_name varchar(150) [not null]
  city varchar(100) [not null]
  state_region varchar(100) [not null]
  country_code char(2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table inventory.stock {
  stock_id bigint [pk, increment]
  warehouse_id bigint [not null]
  product_id bigint [not null]
  on_hand_quantity integer [not null, default: 0]
  reserved_quantity integer [not null, default: 0]
  reorder_level integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 0]

  Indexes {
    (warehouse_id, product_id) [unique, name: 'uq_stock_warehouse_product']

    product_id [name: 'idx_stock_product']
  }

  Note: "Available quantity is calculated as on_hand_quantity minus reserved_quantity."
}

Ref: inventory.stock.warehouse_id > inventory.warehouses.warehouse_id
Ref: inventory.stock.product_id > catalog.products.product_id

/*
=========================================================
COMMERCE SCHEMA — CART
=========================================================
*/

Table commerce.carts {
  cart_id bigint [pk, increment]
  public_id uuid [not null, unique]
  customer_id bigint [not null]
  status cart_status [not null, default: 'ACTIVE']
  currency_code char(3) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  version bigint [not null, default: 0]

  Indexes {
    customer_id [name: 'idx_carts_customer']
    (customer_id, status) [name: 'idx_carts_customer_status']
  }
}

Table commerce.cart_items {
  cart_item_id bigint [pk, increment]
  cart_id bigint [not null]
  product_id bigint [not null]
  quantity integer [not null]
  displayed_unit_price numeric(19,4) [not null]
  added_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (cart_id, product_id) [unique, name: 'uq_cart_items_cart_product']

    product_id [name: 'idx_cart_items_product']
  }
}

Ref: commerce.carts.customer_id > identity.customers.customer_id
Ref: commerce.cart_items.cart_id > commerce.carts.cart_id
Ref: commerce.cart_items.product_id > catalog.products.product_id

/*
=========================================================
COMMERCE SCHEMA — ORDERS
=========================================================
*/

Table commerce.orders {
  order_id bigint [pk, increment]
  public_id uuid [not null, unique]
  order_number varchar(40) [not null, unique]
  customer_id bigint [not null]
  cart_id bigint
  status order_status [not null, default: 'PENDING']
  currency_code char(3) [not null]
  subtotal_amount numeric(19,4) [not null]
  discount_amount numeric(19,4) [not null, default: 0]
  tax_amount numeric(19,4) [not null, default: 0]
  shipping_amount numeric(19,4) [not null, default: 0]
  total_amount numeric(19,4) [not null]
  idempotency_key varchar(100) [not null, unique]
  ordered_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 0]

  Indexes {
    order_number [unique, name: 'uq_orders_number']
    idempotency_key [unique, name: 'uq_orders_idempotency']
    (customer_id, ordered_at) [name: 'idx_orders_customer_time']
    (status, ordered_at) [name: 'idx_orders_status_time']
  }
}

Table commerce.order_items {
  order_item_id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null]
  sku_snapshot varchar(64) [not null]
  product_name_snapshot varchar(255) [not null]
  quantity integer [not null]
  unit_price numeric(19,4) [not null]
  discount_amount numeric(19,4) [not null, default: 0]
  tax_amount numeric(19,4) [not null, default: 0]
  line_total numeric(19,4) [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    order_id [name: 'idx_order_items_order']
    product_id [name: 'idx_order_items_product']
  }

  Note: "Stores product and price snapshots so historical orders do not change with the catalogue."
}

Table commerce.order_addresses {
  order_address_id bigint [pk, increment]
  order_id bigint [not null]
  address_role varchar(20) [not null]
  recipient_name varchar(200) [not null]
  phone_number varchar(32)
  address_line_1 varchar(255) [not null]
  address_line_2 varchar(255)
  city varchar(100) [not null]
  state_region varchar(100) [not null]
  postal_code varchar(20) [not null]
  country_code char(2) [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (order_id, address_role) [unique, name: 'uq_order_addresses_role']
  }
}

Table commerce.order_status_history {
  order_status_history_id bigint [pk, increment]
  order_id bigint [not null]
  previous_status order_status
  new_status order_status [not null]
  reason varchar(500)
  changed_by varchar(100)
  changed_at timestamptz [not null, default: `now()`]

  Indexes {
    (order_id, changed_at) [name: 'idx_order_status_history']
  }
}

Ref: commerce.orders.customer_id > identity.customers.customer_id
Ref: commerce.orders.cart_id > commerce.carts.cart_id
Ref: commerce.order_items.order_id > commerce.orders.order_id
Ref: commerce.order_items.product_id > catalog.products.product_id
Ref: commerce.order_addresses.order_id > commerce.orders.order_id
Ref: commerce.order_status_history.order_id > commerce.orders.order_id

/*
=========================================================
INVENTORY RESERVATIONS
=========================================================
*/

Table inventory.reservations {
  reservation_id bigint [pk, increment]
  public_id uuid [not null, unique]
  order_id bigint [not null]
  order_item_id bigint [not null]
  warehouse_id bigint [not null]
  product_id bigint [not null]
  quantity integer [not null]
  status reservation_status [not null, default: 'PENDING']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 0]

  Indexes {
    order_id [name: 'idx_reservations_order']
    (warehouse_id, product_id, status) [
      name: 'idx_reservations_stock_status'
    ]
  }
}

Ref: inventory.reservations.order_id > commerce.orders.order_id
Ref: inventory.reservations.order_item_id > commerce.order_items.order_item_id
Ref: inventory.reservations.warehouse_id > inventory.warehouses.warehouse_id
Ref: inventory.reservations.product_id > catalog.products.product_id

/*
=========================================================
PAYMENT SCHEMA
=========================================================
*/

Table payment.payments {
  payment_id bigint [pk, increment]
  public_id uuid [not null, unique]
  order_id bigint [not null]
  status payment_status [not null, default: 'INITIATED']
  currency_code char(3) [not null]
  requested_amount numeric(19,4) [not null]
  paid_amount numeric(19,4) [not null, default: 0]
  refunded_amount numeric(19,4) [not null, default: 0]
  payment_method varchar(30) [not null]
  provider_name varchar(100)
  provider_payment_reference varchar(255)
  idempotency_key varchar(100) [not null, unique]
  initiated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  version bigint [not null, default: 0]

  Indexes {
    order_id [name: 'idx_payments_order']
    idempotency_key [unique, name: 'uq_payments_idempotency']
    provider_payment_reference [name: 'idx_payments_provider_reference']
    (status, initiated_at) [name: 'idx_payments_status_time']
  }
}

Table payment.payment_attempts {
  payment_attempt_id bigint [pk, increment]
  payment_id bigint [not null]
  attempt_number smallint [not null]
  status payment_status [not null]
  provider_request_id varchar(255)
  provider_response_code varchar(100)
  failure_reason varchar(500)
  requested_at timestamptz [not null, default: `now()`]
  responded_at timestamptz

  Indexes {
    (payment_id, attempt_number) [unique, name: 'uq_payment_attempt_number']
  }
}

Table payment.payment_status_history {
  payment_status_history_id bigint [pk, increment]
  payment_id bigint [not null]
  previous_status payment_status
  new_status payment_status [not null]
  reason varchar(500)
  changed_at timestamptz [not null, default: `now()`]

  Indexes {
    (payment_id, changed_at) [name: 'idx_payment_status_history']
  }
}

Ref: payment.payments.order_id > commerce.orders.order_id
Ref: payment.payment_attempts.payment_id > payment.payments.payment_id
Ref: payment.payment_status_history.payment_id > payment.payments.payment_id

/*
=========================================================
TRANSACTIONAL OUTBOX
=========================================================
*/

Table outbox.events {
  event_id uuid [pk]
  aggregate_type varchar(100) [not null]
  aggregate_id varchar(100) [not null]
  event_type varchar(150) [not null]
  event_version integer [not null, default: 1]
  payload jsonb [not null]
  headers jsonb
  status event_status [not null, default: 'PENDING']
  occurred_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  retry_count integer [not null, default: 0]
  last_error text

  Indexes {
    (status, created_at) [name: 'idx_outbox_pending']
    (aggregate_type, aggregate_id, occurred_at) [
      name: 'idx_outbox_aggregate'
    ]
  }

  Note: "Written in the same transaction as the business change and captured by Debezium."
}

/*
=========================================================
AUDIT SCHEMA
=========================================================
*/

Table audit.audit_events {
  audit_event_id bigint [pk, increment]
  actor_type varchar(50) [not null]
  actor_id varchar(100)
  action varchar(150) [not null]
  entity_type varchar(100) [not null]
  entity_id varchar(100)
  source_ip inet
  correlation_id uuid
  details jsonb
  occurred_at timestamptz [not null, default: `now()`]

  Indexes {
    (entity_type, entity_id, occurred_at) [
      name: 'idx_audit_entity_time'
    ]

    (actor_type, actor_id, occurred_at) [
      name: 'idx_audit_actor_time'
    ]

    correlation_id [name: 'idx_audit_correlation']
  }
}